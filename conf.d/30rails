#!/bin/bash -ex

source /usr/local/src/canvas.conf

# Preserve the database identity generated by common/rails before removing its
# disposable scaffold. The common module derives this name from the build
# hostname, so it must not be assumed to be "canvas".
mapfile -t common_database_files < <(
    find /var/www -mindepth 3 -maxdepth 3 -type f \
        -path '*/config/database.yml' -print
)
[[ ${#common_database_files[@]} -eq 1 ]]
COMMON_DATABASE=${common_database_files[0]}
COMMON_WEBROOT=${COMMON_DATABASE%/config/database.yml}

set +x
COMMON_DB_USER=$(awk '/^[[:space:]]+username:/ {print $2; exit}' \
    "$COMMON_DATABASE")
DB_PASS=$(awk '/^[[:space:]]+password:/ {print $2; exit}' \
    "$COMMON_DATABASE")
[[ $COMMON_DB_USER =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]
[[ $DB_PASS =~ ^[0-9a-f]{32}$ ]]
[[ $COMMON_WEBROOT == "/var/www/$COMMON_DB_USER" ]]
sed -i "s|^export COMMON_DB_USER=.*|export COMMON_DB_USER=$COMMON_DB_USER|" \
    /usr/local/src/canvas.conf
sed -i "s|^export DB_PASS=.*|export DB_PASS=$DB_PASS|" \
    /usr/local/src/canvas.conf
set -x

# Remove the common scaffold and its hostname-specific service configuration.
rm -rf "$COMMON_WEBROOT" "/var/log/$COMMON_DB_USER"
rm -f "/etc/apache2/conf/$COMMON_DB_USER.conf"
if [[ $COMMON_DB_USER != canvas ]]; then
    rm -f "/etc/apache2/sites-available/$COMMON_DB_USER.conf" \
        "/etc/apache2/sites-enabled/$COMMON_DB_USER.conf" \
        "/etc/logrotate.d/$COMMON_DB_USER"
fi
