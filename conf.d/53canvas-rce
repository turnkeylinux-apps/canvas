#!/bin/bash -ex

# Add RCE_API Apache port to default ports conf file
sed -i "/Listen 443/ a \\\\tListen 3000" /etc/apache2/ports.conf

source /usr/local/src/canvas.conf

RCE_ROOT=/var/www/canvas-rce-api
ARCHIVE=/usr/local/src/canvas-rce-$RCE_COMMIT.tar.gz
URL=https://github.com/instructure/canvas-rce-api/archive/$RCE_COMMIT.tar.gz
curl_args=(-fsSL)
[[ -z ${FAB_HTTP_PROXY:-} ]] || curl_args+=(--proxy "$FAB_HTTP_PROXY")
curl "${curl_args[@]}" "$URL" -o "$ARCHIVE"
echo "$RCE_SHA256  $ARCHIVE" | sha256sum --check --status

install -d "$RCE_ROOT"
tar -xzf "$ARCHIVE" --strip-components=1 -C "$RCE_ROOT"
rm -f "$ARCHIVE"

# The pinned RCE tree imports dev-null for request logging at runtime but
# classifies it as a development dependency. Correct the official lock
# metadata so the production-only install includes the already locked tarball.
RUNTIME_PATCH=/usr/local/src/canvas_rce_runtime_dependency.patch
echo "$RCE_RUNTIME_PATCH_SHA256  $RUNTIME_PATCH" | sha256sum --check --status
git -C "$RCE_ROOT" apply "$RUNTIME_PATCH"
install -D -m 0644 "$RUNTIME_PATCH" \
    /usr/local/share/turnkey-canvas/canvas_rce_runtime_dependency.patch
rm -f "$RUNTIME_PATCH"

# Passenger accepts a startup file but not npm start's --import option. Use an
# appliance-owned wrapper to load dotenv and instrumentation before app.js.
PASSENGER_START=/usr/local/src/canvas_rce_passenger.js
echo "$RCE_PASSENGER_SHA256  $PASSENGER_START" | sha256sum --check --status
install -m 0644 "$PASSENGER_START" "$RCE_ROOT/turnkey-passenger.js"
install -m 0644 "$PASSENGER_START" \
    /usr/local/share/turnkey-canvas/canvas_rce_passenger.js
rm -f "$PASSENGER_START"

cd "$RCE_ROOT"
npm ci --omit=dev
cp .env.example .env
install -d -o www-data -g www-data tmp

sed -i "s|^PORT=.*|PORT=3000|" .env
sed -i "s|NODE_ENV=.*|NODE_ENV=production|" .env
