+def ResolveSourceURI(path, uri, importRoot):
+	"""Resolve a package reference without allowing it outside importRoot."""
+	if not importRoot:
+		raise ValueError("QTI import root is unavailable")
+	root=os.path.realpath(importRoot)
+	base=os.path.dirname(os.path.realpath(path))
+	segments=[DecodePathSegment(segment) for segment in uri.split('/')]
+	candidate=os.path.realpath(os.path.join(base,*segments))
+	try:
+		contained=os.path.commonpath([root,candidate]) == root
+	except ValueError:
+		contained=False
+	if not contained:
+		raise ValueError("QTI source reference leaves import root: %s"%uri)
+	return candidate
+
