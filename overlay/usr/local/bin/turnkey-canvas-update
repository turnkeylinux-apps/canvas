#!/bin/bash
set -euo pipefail

APP_ROOT=/var/www/canvas
RCE_ROOT=/var/www/canvas-rce-api
SOURCE_FILE=/usr/local/share/turnkey-canvas/source
CANVAS_REPO=https://github.com/instructure/canvas-lms.git
RCE_REPO=https://github.com/instructure/canvas-rce-api.git
CANVAS_API=https://api.github.com/repos/instructure/canvas-lms
RCE_API=https://api.github.com/repos/instructure/canvas-rce-api
ASSET_PATH=ui/features/discovery_page/react/components/ConfigureModal.tsx
ASSET_BROKEN_IMPORT="import {showFlashAlert} from '@instructure/platform-alerts'"
ASSET_FIXED_IMPORT="import {showFlashAlert} from '@canvas/alerts/react/FlashAlert'"

usage() {
    echo "usage: turnkey-canvas-update --check | --apply [--dry-run]" >&2
    exit 2
}

source_value() {
    local key=$1
    sed -n "s/^${key}=//p" "$SOURCE_FILE" | head -n 1
}

remote_head() {
    local repo=$1
    local branch=$2
    git ls-remote "$repo" "refs/heads/$branch" | awk 'NR == 1 {print $1}'
}

remote_tree() {
    local api=$1
    local commit=$2
    curl -fsSL "$api/git/commits/$commit" | python3 -c '
import json
import re
import sys

tree = json.load(sys.stdin).get("tree", {}).get("sha", "")
if not re.fullmatch(r"[0-9a-f]{40}", tree):
    raise SystemExit(1)
print(tree, end="")
'
}

[[ $# -ge 1 && $# -le 2 ]] || usage
mode=$1
dry_run=false
case "$mode" in
    --check)
        [[ $# -eq 1 ]] || usage
        ;;
    --apply)
        if [[ $# -eq 2 ]]; then
            [[ $2 = --dry-run ]] || usage
            dry_run=true
        fi
        ;;
    *)
        usage
        ;;
esac

[[ -r $SOURCE_FILE && -d $APP_ROOT && -d $RCE_ROOT ]] || {
    echo "Canvas source provenance is unavailable" >&2
    exit 1
}

installed=$(source_value version)
canvas_commit=$(source_value canvas_commit)
canvas_tree=$(source_value canvas_tree)
rce_commit=$(source_value rce_commit)
rce_tree=$(source_value rce_tree)
canvas_asset_patch_commit=$(source_value canvas_asset_patch_commit)
canvas_asset_patch_sha256=$(source_value canvas_asset_patch_sha256)
[[ $installed =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || {
    echo "Installed Canvas version is invalid" >&2
    exit 1
}
for identity in "$canvas_commit" "$canvas_tree" "$rce_commit" "$rce_tree"; do
    [[ $identity =~ ^[0-9a-f]{40}$ ]] || {
        echo "Installed Canvas source identity is invalid" >&2
        exit 1
    }
done
[[ $canvas_asset_patch_commit =~ ^[0-9a-f]{40}$ && \
    $canvas_asset_patch_sha256 =~ ^[0-9a-f]{64}$ ]] || {
    echo "Installed Canvas asset patch identity is invalid" >&2
    exit 1
}
asset_patch=/usr/local/share/turnkey-canvas/canvas_platform_alerts.patch
echo "$canvas_asset_patch_sha256  $asset_patch" | sha256sum --check --status || {
    echo "Canvas asset patch integrity check failed" >&2
    exit 1
}

candidate=$(remote_head "$CANVAS_REPO" prod)
candidate_rce=$(remote_head "$RCE_REPO" master)
[[ $candidate =~ ^[0-9a-f]{40}$ && $candidate_rce =~ ^[0-9a-f]{40}$ ]] || {
    echo "Official Canvas update channels could not be resolved" >&2
    exit 1
}
candidate_tree=$(remote_tree "$CANVAS_API" "$candidate")
candidate_rce_tree=$(remote_tree "$RCE_API" "$candidate_rce")
candidate_asset=$(curl -fsSL \
    "https://raw.githubusercontent.com/instructure/canvas-lms/$candidate/$ASSET_PATH")
if grep -Fxq "$ASSET_BROKEN_IMPORT" <<<"$candidate_asset"; then
    asset_fix=required
elif grep -Fxq "$ASSET_FIXED_IMPORT" <<<"$candidate_asset"; then
    asset_fix=upstream
else
    echo "Official Canvas source has an unsupported asset import" >&2
    exit 1
fi

status=update-available
if [[ $canvas_commit = "$candidate" && $rce_commit = "$candidate_rce" ]]; then
    status=up-to-date
fi

if [[ $mode = --check ]]; then
    printf 'installed=%s\ncanvas_commit=%s\ncanvas_tree=%s\n' \
        "$installed" "$canvas_commit" "$canvas_tree"
    printf 'rce_commit=%s\nrce_tree=%s\n' "$rce_commit" "$rce_tree"
    printf 'candidate=%s\ncandidate_tree=%s\n' "$candidate" "$candidate_tree"
    printf 'candidate_rce=%s\ncandidate_rce_tree=%s\n' \
        "$candidate_rce" "$candidate_rce_tree"
    printf 'asset_fix=%s\nasset_patch_commit=%s\n' \
        "$asset_fix" "$canvas_asset_patch_commit"
    printf 'channel=official-canvas-prod\nrce_channel=official-canvas-rce-master\n'
    printf 'status=%s\n' "$status"
    exit 0
fi

if $dry_run; then
    printf 'mode=apply-dry-run\ntarget=%s\ntarget_tree=%s\n' \
        "$candidate" "$candidate_tree"
    printf 'rce_target=%s\nrce_target_tree=%s\n' \
        "$candidate_rce" "$candidate_rce_tree"
    printf 'asset_fix=%s\nasset_patch_commit=%s\n' \
        "$asset_fix" "$canvas_asset_patch_commit"
    printf 'verified=official-branch-commits-trees-and-asset-fix\nstatus=%s\n' "$status"
    exit 0
fi

[[ $EUID -eq 0 ]] || {
    echo "--apply must run as root" >&2
    exit 1
}

if [[ $status = up-to-date ]]; then
    echo "Canvas production source is already current"
    exit 0
fi

stage=$(mktemp -d /var/tmp/turnkey-canvas-update.XXXXXX)
services_stopped=false
cleanup() {
    local rc=$?
    if $services_stopped; then
        service apache2 start || true
        service canvas_init start || true
    fi
    rm -rf "$stage"
    exit "$rc"
}
trap cleanup EXIT

git init -q "$stage/canvas"
git -C "$stage/canvas" remote add origin "$CANVAS_REPO"
git -C "$stage/canvas" fetch -q --depth 1 origin "$candidate"
git -C "$stage/canvas" checkout -q --detach FETCH_HEAD
[[ $(git -C "$stage/canvas" rev-parse HEAD) = "$candidate" ]]
[[ $(git -C "$stage/canvas" rev-parse 'HEAD^{tree}') = "$candidate_tree" ]]
if [[ $asset_fix = required ]]; then
    grep -Fqx "$ASSET_BROKEN_IMPORT" "$stage/canvas/$ASSET_PATH"
    git -C "$stage/canvas" apply "$asset_patch"
else
    grep -Fqx "$ASSET_FIXED_IMPORT" "$stage/canvas/$ASSET_PATH"
fi
git -C "$stage/canvas" apply \
    /usr/local/share/turnkey-canvas/canvas_init.patch

git init -q "$stage/rce"
git -C "$stage/rce" remote add origin "$RCE_REPO"
git -C "$stage/rce" fetch -q --depth 1 origin "$candidate_rce"
git -C "$stage/rce" checkout -q --detach FETCH_HEAD
[[ $(git -C "$stage/rce" rev-parse HEAD) = "$candidate_rce" ]]
[[ $(git -C "$stage/rce" rev-parse 'HEAD^{tree}') = "$candidate_rce_tree" ]]

backup_dir=/var/backups/turnkey-canvas
backup_id=$(date -u +%Y%m%dT%H%M%SZ)
install -d -m 0700 "$backup_dir"
pg_dump canvas_production | gzip -c > "$backup_dir/canvas-$backup_id.sql.gz"
tar -C / -czf "$backup_dir/canvas-$backup_id-files.tar.gz" \
    var/www/canvas/config var/www/canvas/tmp/files \
    var/www/canvas-rce-api/.env

service canvas_init stop
service apache2 stop
services_stopped=true

rsync -a --delete \
    --exclude=/.git \
    --exclude=/.bundle \
    --exclude=/config/GEM_HOME \
    --exclude='/config/*.yml' \
    --exclude=/log \
    --exclude=/tmp \
    --exclude=/vendor/bundle \
    "$stage/canvas/" "$APP_ROOT/"

footer=$APP_ROOT/app/views/layouts/application.html.erb
if ! grep -q 'turnkey-credit' "$footer"; then
    sed -i "s|</footer>|<div id='turnkey-credit' style='text-align:center;padding-top:20px;'><a href='https://www.turnkeylinux.org/canvas'>Canvas Appliance</a> - Powered by <a href='https://www.turnkeylinux.org'>TurnKey Linux</a></div>\n    </footer>|" "$footer"
fi

rsync -a --delete \
    --exclude=/.git \
    --exclude=/.env \
    --exclude=/tmp \
    "$stage/rce/" "$RCE_ROOT/"

cd "$APP_ROOT"
bundler_version=$(awk '/^BUNDLED WITH$/ {getline; gsub(/^[[:space:]]+/, ""); print; exit}' Gemfile.lock)
[[ $bundler_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
gem install bundler --no-document --version "$bundler_version"
bundle config set --local path vendor/bundle
bundle install
yarn install --frozen-lockfile --network-timeout 1000000
RAILS_ENV=production COMPILE_ASSETS_BRAND_CONFIGS=0 \
    COMPILE_ASSETS_NPM_INSTALL=0 bundle exec rails canvas:compile_assets
RAILS_ENV=production bundle exec rails db:migrate
RAILS_ENV=production bundle exec rails db:load_notifications

cd "$RCE_ROOT"
npm ci --omit=dev

chown -R root:www-data "$APP_ROOT/config"
find "$APP_ROOT/config" -type d -exec chmod 0750 {} \;
find "$APP_ROOT/config" -type f -name '*.yml' -exec chmod 0440 {} \;
chown -R www-data:www-data "$APP_ROOT/log" "$APP_ROOT/tmp"
chown -R root:root "$RCE_ROOT"
chown -R www-data:www-data "$RCE_ROOT/tmp"
chown root:www-data "$RCE_ROOT/.env"
chmod 0440 "$RCE_ROOT/.env"

cat > "$SOURCE_FILE" <<EOF
version=$(date -u +%Y-%m-%d)
canvas_channel=prod
canvas_commit=$candidate
canvas_tree=$candidate_tree
canvas_archive_sha256=not-applicable-git-update
canvas_asset_patch_commit=$canvas_asset_patch_commit
canvas_asset_patch_sha256=$canvas_asset_patch_sha256
rce_channel=master
rce_commit=$candidate_rce
rce_tree=$candidate_rce_tree
rce_archive_sha256=not-applicable-git-update
ruby=$(ruby -e 'print RUBY_VERSION')
rails=$(cd "$APP_ROOT" && BUNDLE_PATH=vendor/bundle bundle exec rails --version | awk '{print $2}')
node=$(node --version)
yarn=$(yarn --version)
yarn_source=official-yarn-apt
EOF
chmod 0644 "$SOURCE_FILE"

service apache2 start
service canvas_init start
services_stopped=false

printf 'updated=%s\ncanvas_commit=%s\nrce_commit=%s\nbackup=%s\n' \
    "$(source_value version)" "$candidate" "$candidate_rce" "$backup_id"
